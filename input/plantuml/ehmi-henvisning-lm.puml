@startuml
hide methods
hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Henvisning – Logisk FHIR Model

package "HenvisningLM" {

  class HenvisningLM {
    +oprettetDato : dateTime [1]
    +prioritet : code [1]
    +ydelseskode : CodeableConcept [1]
    +anamnese : string [0..1]
    +medicin : string [0..1]
    +oensketTidspunkt : dateTime [0..1]
  }

  class PatientLM {
    +cpr : string [1]
    +navn : HumanName [1]
    +adresse : Address [0..1]
    +telefon : ContactPoint [0..1]
  }

  class HenviserLM {
    +autorisationsId : string [1]
    +navn : HumanName [1]
    +speciale : CodeableConcept [0..1]
    +kontakt : ContactPoint [0..1]
  }

  class VisitatorLM {
    +autorisationsId : string [1]
    +navn : HumanName [1]
    +speciale : CodeableConcept [0..1]
    +kontakt : ContactPoint [0..1]
  }

}

package "HenvisningLM detaljer" {

  class Indikation {
    +diagnose : CodeableConcept [0..1]
    +friTekst : string [0..1]
  }

  class Paraklinik {
    +type : code [1]
    +reference : Reference [1]
  }

  class AktueltProblem {
    +problem : CodeableConcept
  }

}


' ------------------------------------------------------------
' Root relationer
' ------------------------------------------------------------

HenvisningLM *-- "1" PatientLM : Patient
HenvisningLM *-- "1" HenviserLM : Henviser
HenvisningLM *-- "1" VisitatorLM : Visitator

' ------------------------------------------------------------
' Henvisning relationer
' ------------------------------------------------------------

HenvisningLM *-- "1..*" Indikation : indikation
HenvisningLM *-- "0..*" Paraklinik : paraklinik
HenvisningLM *-- "0..*" AktueltProblem : aktuelleProblemer

@enduml